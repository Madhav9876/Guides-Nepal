VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend API URL (optional - defaults to /api/v1 in dev or the production URL)
# VITE_API_URL=https://guides-nepal.onrender.com/api/v1

# OAuth URLs (optional - defaults to backend endpoints)
# VITE_GOOGLE_OAUTH_URL=https://guides-nepal.onrender.com/api/v1/auth/oauth/google/start
# VITE_FACEBOOK_OAUTH_URL=https://guides-nepal.onrender.com/api/v1/auth/oauth/facebook/start
# VITE_APPLE_OAUTH_URL=

# Dev-only: Set to 1 to enable fake login (never in production)
# VITE_DEV_FAKE_LOGIN=0