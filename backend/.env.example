ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/db
SECRET_KEY=change_me_in_production

# Supabase (used for password reset email verification)
# The URL of your Supabase project, e.g. https://your-project.supabase.co
SUPABASE_URL=https://your-supabase-url.supabase.co
# The service role key (NOT the anon/publishable key) - keep this secret!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Where the reset link in the email lands the user. MUST be listed under
# Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs.
# Example for the production Vercel frontend:
RESET_PASSWORD_REDIRECT_URL=https://your-frontend-domain.vercel.app/reset-password
